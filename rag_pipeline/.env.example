# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Qdrant Cloud ─────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# ── Storage ──────────────────────────────────────────────────────────────────
# Local dev (Windows): C:\path\to\RAG_One_Space\backend\storage
# Local dev (macOS/Linux): /path/to/RAG_One_Space/backend/storage
# Docker: overridden automatically to /app/storage via docker-compose
STORAGE_BASE_PATH=/path/to/backend/storage