# ── Google Drive ────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Dropbox ──────────────────────────────────────────────────────────────────
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REDIRECT_URI=https://<your-public-tunnel-url>/dropbox/callback

# ── General ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=50
POLL_INTERVAL_SECONDS=30
WEBHOOK_URL=https://<your-public-tunnel-url>

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── RAG Pipeline ─────────────────────────────────────────────────────────────
# Local dev: http://localhost:8001
# Docker: overridden automatically to http://rag-pipeline:8001 via docker-compose
RAG_PIPELINE_URL=http://localhost:8001